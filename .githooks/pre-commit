#!/bin/zsh

emulate -LR zsh
setopt NO_UNSET PIPE_FAIL

readonly hook_dir="${0:A:h}"
readonly repo_root="${hook_dir:h}"

"$repo_root/tests/smoke.zsh" --quick || exit 1

if (( ! $+commands[gitleaks] )); then
  print -u2 -- 'pre-commit: 缺少 gitleaks 8.30.0；请先完成 Stage 2 tooling 安装'
  exit 1
fi

readonly gitleaks_version="$(gitleaks version 2>/dev/null | grep -Eo '[0-9]+\.[0-9]+\.[0-9]+' | head -n1)"
if [[ "$gitleaks_version" != 8.30.0 ]]; then
  print -u2 -- "pre-commit: 要求 gitleaks 8.30.0，当前为 ${gitleaks_version:-unknown}"
  exit 1
fi

gitleaks dir --redact --no-banner "$repo_root" || exit 1
print -- 'pre-commit: 通过'
