# dotfiles: local-integrations zprofile-pre
if [[ -r "$HOME/.config/dotfiles/local/integrations.zsh" ]]; then
  DOTFILES_INTEGRATIONS_PHASE=zprofile-pre
  source "$HOME/.config/dotfiles/local/integrations.zsh" ||
    print -u2 -- "dotfiles: integrations.zsh zprofile-pre 加载失败"
  unset DOTFILES_INTEGRATIONS_PHASE
fi

# Apple Silicon login environment.
typeset -U path PATH

if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

export PNPM_HOME="$HOME/Library/pnpm"
path=(
  /opt/homebrew/bin
  /opt/homebrew/sbin
  "$PNPM_HOME"
  "$HOME/.local/bin"
  "${path[@]}"
)
export PATH

# dotfiles: local-integrations zprofile-post
if [[ -r "$HOME/.config/dotfiles/local/integrations.zsh" ]]; then
  DOTFILES_INTEGRATIONS_PHASE=zprofile-post
  source "$HOME/.config/dotfiles/local/integrations.zsh" ||
    print -u2 -- "dotfiles: integrations.zsh zprofile-post 加载失败"
  unset DOTFILES_INTEGRATIONS_PHASE
fi
