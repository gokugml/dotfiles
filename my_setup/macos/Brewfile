brew "ast-grep" # 提供 AST 结构化代码搜索与重构
brew "gh" # 提供 GitHub 命令行客户端
brew "git-lfs" # 提供 Git 大文件存储支持
brew "graphviz" # 提供图形布局与 dot 图渲染
