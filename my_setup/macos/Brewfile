brew "poppler" # 提供 PDF 检查、转换与渲染工具
brew "ripgrep" # 提供快速递归文本搜索
brew "rsync" # 提供文件与目录同步
brew "silicon" # 将源代码渲染为图片
brew "tmux" # 提供终端复用
brew "tree" # 以树形展示目录结构
brew "uv" # 管理 Python 版本、虚拟环境和 Python CLI 工具
brew "vhs" # 录制与回放终端演示
brew "zoxide" # 提供智能目录跳转，替代 autojump

cask "typeless" # AI 语音听写并整理为润色后的文本
