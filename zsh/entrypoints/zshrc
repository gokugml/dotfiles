# shellcheck shell=zsh
[[ -o interactive ]] || return 0 # 功能=限制交互配置只在交互 shell 加载；最佳实践=pass；修改级别=一定要改；建议=非交互 shell 不加载主题补全和插件；归属=public；验证=zsh -c 不出现交互副作用

typeset -g DOTFILES_PUBLIC_ROOT="${DOTFILES_PUBLIC_ROOT:-${${(%):-%N}:A:h:h:h}}" # 功能=定位公开配置根目录；最佳实践=rewrite；修改级别=一定要改；建议=从薄入口自身路径推导并允许测试覆盖；归属=public；验证=候选树与正式仓库路径均可加载

builtin source "$DOTFILES_PUBLIC_ROOT/zsh/lib.zsh" || return 1 # 功能=加载统一公共运行时；最佳实践=rewrite；修改级别=一定要改；建议=入口只加载按原文件章节组织的集中运行时；归属=public；验证=loader 失败时严格模式阻断

if [[ "$(command arch 2>/dev/null)" != arm64 ]]; then
  print -u2 -- "dotfiles: 当前 shell 不是原生 arm64；不会启用 Intel Homebrew 回退" # 功能=警告 Rosetta 会话；最佳实践=pass；修改级别=一定要改；建议=只警告且不拼接 usr-local；归属=public；验证=x86_64 fixture 仅产生警告
fi

dotfiles_source_phase pre # 功能=在框架前加载三层 fpath 和主题选择；最佳实践=rewrite；修改级别=一定要改；建议=固定 public-company-local 顺序；归属=public；验证=OMZ source 前 fpath 已唯一化

if [[ -r "${ZSH:-$HOME/.oh-my-zsh}/oh-my-zsh.sh" && -z "${_DOTFILES_OMZ_SOURCED:-}" ]]; then
  typeset -g _DOTFILES_OMZ_SOURCED=1
  builtin source "${ZSH:-$HOME/.oh-my-zsh}/oh-my-zsh.sh" # 功能=加载唯一一次 Oh My Zsh 与 compinit；最佳实践=rewrite；修改级别=一定要改；建议=官方 origin 由安装和诊断门禁校验；归属=public；验证=重复 source 时 compinit 计数仍为一
elif [[ ! -r "${ZSH:-$HOME/.oh-my-zsh}/oh-my-zsh.sh" ]]; then
  print -u2 -- "dotfiles: Oh My Zsh 尚未安装，继续提供基础 shell"
fi

dotfiles_source_phase rc # 功能=在框架后加载三层交互配置；最佳实践=rewrite；修改级别=一定要改；建议=本地和公司层失败时日常降级；归属=public；验证=缺少可选层时启动成功
dotfiles_activate_external_plugins # 功能=最后激活外部 ZLE 插件；最佳实践=rewrite；修改级别=建议修改；建议=autosuggestions 后加载 syntax-highlighting；归属=public；验证=syntax-highlighting 为最后注册的外部插件
